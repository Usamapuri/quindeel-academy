# Copy to .env and fill in. On Railway these are set as service variables.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT signing secret for auth cookies (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=""

# Bootstrap teacher account (created idempotently by prisma/seed.ts). Change the password after first login.
TEACHER_NAME="Prof. Muhammad Zaheer Quindeel"
TEACHER_EMAIL="teacher@quindeel.academy"
TEACHER_PASSWORD=""

# Public base URL (used for OAuth redirect + absolute links)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Google Calendar / Meet integration (optional — live classes fall back to a manual paste link if unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Cloudinary — photo gallery storage (optional; the gallery upload button is hidden if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
